# Copie para .env e preencha localmente. Nunca adicione valores reais ao Git.
LINKEDIN_EMAIL=
LINKEDIN_SENHA=
CAMINHO_CURRICULO=

# A IA local fica desligada até ser habilitada explicitamente.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=local-model-name
AI_ALLOW_REMOTE=false
AI_TIMEOUT_SECONDS=15
AI_REVIEW_PAUSE_SECONDS=2
AI_RESPONSE_LANGUAGE=Portuguese
AI_PROFILE_CONTEXT=

# Copy candidate_profile.example.txt to candidate_profile.txt and customize it.
AI_PROFILE_FILE=./candidate_profile.txt

# Set these to the role(s) this user wants. Separate alternative phrases with commas.
PALAVRAS_CHAVE=Analista de infraestrutura

# Optional initial exclusion selection. Comma-separated; empty uses the defaults.
AI_EXCLUDED_ROLE_TERMS=

# Configuração opcional
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_DEBUG_PROFILE_PATH=C:\ChromeDebugProfile
SELENIUM_WAIT_SECONDS=10
TRANSITION_WAIT_SECONDS=5
JOB_INTERVAL_SECONDS=4
# APP_DATA_DIR=data
