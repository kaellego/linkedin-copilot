# Copie para .env e preencha localmente. Nunca adicione valores reais ao Git.
LINKEDIN_EMAIL=
LINKEDIN_SENHA=
CAMINHO_CURRICULO=

# A IA local fica desligada até ser habilitada explicitamente.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_TIMEOUT_SECONDS=15
AI_REVIEW_PAUSE_SECONDS=2
AI_PROFILE_CONTEXT=

# Configuração opcional
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_DEBUG_PROFILE_PATH=C:\ChromeDebugProfile
SELENIUM_WAIT_SECONDS=10
TRANSITION_WAIT_SECONDS=5
# APP_DATA_DIR=data
